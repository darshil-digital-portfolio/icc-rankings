FROM python:3.12-slim

# Lambda Web Adapter: translates Lambda invocation events → HTTP → your FastAPI app
COPY --from=public.ecr.aws/awsguru/aws-lambda-web-adapter:0.8.4 \
     /lambda-adapter /opt/extensions/lambda-adapter

WORKDIR /app

# Install system dependencies for psycopg binary.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8100
# PORT tells Lambda Web Adapter which port to forward requests to
ENV PORT=8100

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8100"]
