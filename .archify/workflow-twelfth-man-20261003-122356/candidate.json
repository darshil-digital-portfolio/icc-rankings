  "cards": [
    {
      "dot": "emerald",
      "title": "Routing",
      "items": [
        "One LLM call classifies each message into five intents",
        "Clarification questions return straight from the Router",
        "Greeting and off-topic replies cost no data access"
      ]
    },
    {
      "dot": "rose",
      "title": "Guardrails",
      "items": [
        "Single SELECT or WITH statements only, no comments",
        "Row limit enforced, then run in a read-only transaction with a timeout",
        "Pandas code runs with restricted builtins"
      ]
    },
    {
      "dot": "violet",
      "title": "Output",
      "items": [
        "Formatter turns rows or analysis into prose",
        "Optional chart spec is checked before it is returned",
        "Errors from SQL or analytics also go through the Formatter"
      ]
    }
  ]
