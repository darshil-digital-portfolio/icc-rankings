# ─── Rust API (public — safe to bake into the client bundle) ─────────────────
NEXT_PUBLIC_API_URL=http://localhost:7429
NEXT_PUBLIC_CHATBOT_URL=http://localhost:8100

# ─── Google OAuth (https://console.cloud.google.com/) ────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ─── NextAuth.js ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=replace-with-32-byte-hex-secret
NEXTAUTH_URL=http://localhost:5237

# ─── Shared PSK between Next.js server and Python chatbot ────────────────────
# Must match SERVICE_API_TOKEN in apps/chatbot/.env
# Generate with: openssl rand -hex 32
SERVICE_API_TOKEN=replace-with-32-byte-hex-secret

# ─── Internal service URL (server-side only, never NEXT_PUBLIC_) ─────────────
# Docker: http://chatbot:8100  |  Local dev: http://localhost:8100
INTERNAL_CHATBOT_URL=http://localhost:8100
